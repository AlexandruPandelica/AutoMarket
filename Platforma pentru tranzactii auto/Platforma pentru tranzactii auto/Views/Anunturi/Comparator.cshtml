@{
    ViewData["Title"] = "Comparator mașini";
}

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    .cmp-root {
        font-family: 'Outfit', sans-serif;
        background: #f5f6f8;
        min-height: 80vh;
        padding: 2.5rem 0 4rem;
    }

    /* ── HEADER ── */
    .cmp-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2.5rem;
    }

    .cmp-title {
        font-size: 1.85rem;
        font-weight: 700;
        color: #111;
        letter-spacing: -0.03em;
        line-height: 1.1;
    }

        .cmp-title span {
            color: #2563eb;
        }

    .cmp-subtitle {
        font-size: 0.8rem;
        color: #94a3b8;
        margin-top: 4px;
        font-weight: 400;
    }

    .cmp-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-cmp-ghost {
        background: #fff;
        border: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 500;
        padding: 8px 16px;
        border-radius: 10px;
        cursor: pointer;
        font-family: 'Outfit', sans-serif;
        transition: all 0.18s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

        .btn-cmp-ghost:hover {
            border-color: #cbd5e1;
            background: #f8fafc;
            color: #334155;
        }

    .btn-cmp-primary {
        background: #2563eb;
        border: none;
        color: #fff;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 9px 20px;
        border-radius: 10px;
        cursor: pointer;
        font-family: 'Outfit', sans-serif;
        transition: all 0.18s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

        .btn-cmp-primary:hover {
            background: #1d4ed8;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 16px #2563eb30;
        }

    /* ── EMPTY STATE ── */
    .cmp-empty {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 420px;
        gap: 14px;
        text-align: center;
    }

    .cmp-empty-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #eff6ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin-bottom: 4px;
    }

    .cmp-empty h4 {
        font-size: 1.2rem;
        font-weight: 600;
        color: #1e293b;
    }

    .cmp-empty p {
        color: #94a3b8;
        font-size: 0.88rem;
        max-width: 300px;
        line-height: 1.7;
    }

    /* ── COLUMNS LAYOUT ── */
    .cmp-columns {
        gap: 18px;
        margin-bottom: 2rem;
        align-items: start;
    }

    .cmp-col {
        display: flex;
        flex-direction: column;
        gap: 12px;
        animation: fadeUp 0.4s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── SCORE CARD ── */
    .score-card {
        background: #fff;
        border: 1.5px solid #e8ecf0;
        border-radius: 16px;
        padding: 1rem 1.25rem;
        transition: border-color 0.2s;
    }

        .score-card.best-score {
            border-color: #2563eb;
            background: #f0f7ff;
        }

    .score-label {
        font-size: 0.62rem;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 3px;
    }

    .score-name {
        font-size: 0.9rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 8px;
    }

    .score-card.best-score .score-name {
        color: #1d4ed8;
    }

    .score-bar-wrap {
        height: 5px;
        background: #e8ecf0;
        border-radius: 99px;
        overflow: hidden;
    }

    .score-bar-fill {
        height: 100%;
        border-radius: 99px;
        background: #2563eb;
        transition: width 1s cubic-bezier(.4,0,.2,1);
    }

    .score-pct {
        font-size: 0.7rem;
        color: #94a3b8;
        margin-top: 5px;
        font-weight: 500;
    }

        .score-pct span {
            color: #2563eb;
            font-weight: 700;
        }

    /* ── CAR CARD ── */
    .car-card {
        background: #fff;
        border: 1.5px solid #e8ecf0;
        border-radius: 20px;
        overflow: hidden;
        position: relative;
        transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
    }

        .car-card:hover {
            box-shadow: 0 8px 32px #0001a, 0 2px 8px #0000a;
            transform: translateY(-2px);
            border-color: #d0d7e2;
        }

        .car-card.best-value {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px #2563eb18, 0 8px 32px #2563eb0d;
        }

    .best-badge {
        position: absolute;
        top: 12px;
        left: 50%;
        transform: translateX(-50%);
        background: #2563eb;
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        padding: 4px 12px;
        border-radius: 20px;
        z-index: 3;
        text-transform: uppercase;
        white-space: nowrap;
        box-shadow: 0 2px 8px #2563eb40;
    }

    .car-img-wrap {
        height: 185px;
        background: linear-gradient(160deg, #f0f4ff 0%, #e8ecf5 100%);
        border-bottom: 1px solid #eef0f4;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .car-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transition: transform 0.4s ease;
        }

    .car-card:hover .car-img-wrap img {
        transform: scale(1.04);
    }

    .car-img-placeholder {
        font-size: 4rem;
        opacity: 0.15;
    }

    .car-price-tag {
        position: absolute;
        bottom: 12px;
        left: 12px;
        background: #1e293b;
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        font-size: 0.95rem;
        padding: 5px 14px;
        border-radius: 8px;
        z-index: 2;
        letter-spacing: -0.01em;
    }

        .car-price-tag.best-price {
            background: #2563eb;
        }

    .car-body {
        padding: 1.1rem 1.2rem 0.8rem;
    }

    .car-name {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 3px;
        letter-spacing: -0.02em;
    }

    .car-location {
        font-size: 0.75rem;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .specs-strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid #f1f3f7;
    }

    .specs-strip-2 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid #f1f3f7;
        border-bottom: 1px solid #f1f3f7;
    }

    .spec-cell {
        padding: 9px 12px;
        border-right: 1px solid #f1f3f7;
        position: relative;
        background: #fff;
        transition: background 0.15s;
    }

        .spec-cell:last-child {
            border-right: none;
        }

        .spec-cell.hl {
            background: #eff6ff;
        }

            .spec-cell.hl::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 2.5px;
                background: #2563eb;
                border-radius: 0 0 2px 2px;
            }

    .spec-cell-label {
        font-size: 0.59rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 2px;
        font-weight: 500;
    }

    .spec-cell-val {
        font-size: 0.83rem;
        font-weight: 600;
        color: #334155;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .spec-cell.hl .spec-cell-label {
        color: #3b82f6;
    }

    .spec-cell.hl .spec-cell-val {
        color: #1d4ed8;
    }

    .car-footer {
        display: flex;
        gap: 8px;
        padding: 0.85rem 1.2rem;
    }

    .btn-car-view {
        flex: 1;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        color: #475569;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 9px 14px;
        border-radius: 10px;
        cursor: pointer;
        font-family: 'Outfit', sans-serif;
        transition: all 0.18s;
        text-align: center;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

        .btn-car-view:hover {
            background: #eff6ff;
            border-color: #bfdbfe;
            color: #2563eb;
        }

    .btn-car-remove {
        background: #fff;
        border: 1.5px solid #fee2e2;
        color: #fca5a5;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 9px 12px;
        border-radius: 10px;
        cursor: pointer;
        font-family: 'Outfit', sans-serif;
        transition: all 0.18s;
    }

        .btn-car-remove:hover {
            background: #fef2f2;
            border-color: #fca5a5;
            color: #ef4444;
        }

    /* ── ADD SLOT ── */
    .add-card {
        background: #fff;
        border: 2px dashed #e2e8f0;
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 360px;
        gap: 12px;
        cursor: pointer;
        transition: all 0.22s;
        text-decoration: none;
        color: #cbd5e1;
    }

        .add-card:hover {
            border-color: #93c5fd;
            background: #f0f7ff;
            color: #60a5fa;
        }

    .add-icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        border: 2px dashed currentColor;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
    }

    .add-text {
        font-size: 0.83rem;
        font-weight: 600;
        letter-spacing: 0.01em;
    }

    .add-hint {
        font-size: 0.72rem;
        color: #cbd5e1;
    }

    /* ── COMPARISON TABLE ── */
    .compare-section {
        background: #fff;
        border: 1.5px solid #e8ecf0;
        border-radius: 20px;
        overflow: hidden;
        animation: fadeUp 0.4s ease 0.3s both;
    }

    .compare-section-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #f1f3f7;
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fafbfd;
    }

    .compare-section-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #2563eb;
        flex-shrink: 0;
    }

    .compare-section-title {
        font-size: 0.88rem;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.01em;
    }

    .compare-table {
        width: 100%;
        border-collapse: collapse;
    }

        .compare-table thead th {
            background: #fafbfd;
            padding: 11px 20px;
            font-family: 'Outfit', sans-serif;
            font-size: 0.72rem;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            text-align: left;
            border-bottom: 1px solid #f1f3f7;
        }

            .compare-table thead th:not(:first-child) {
                text-align: center;
                color: #475569;
                font-size: 0.82rem;
                letter-spacing: -0.01em;
                text-transform: none;
            }

        .compare-table td {
            padding: 12px 20px;
            border-bottom: 1px solid #f8fafc;
            font-size: 0.84rem;
            color: #64748b;
            vertical-align: middle;
            font-family: 'Outfit', sans-serif;
        }

        .compare-table tr:last-child td {
            border-bottom: none;
        }

        .compare-table tbody tr:hover td {
            background: #fafbfd;
        }

        .compare-table td:first-child {
            color: #94a3b8;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            font-weight: 600;
            width: 160px;
        }

        .compare-table td:not(:first-child) {
            text-align: center;
        }

    .td-best {
        color: #2563eb !important;
        font-weight: 700;
        background: #eff6ff !important;
    }

    .td-best-icon {
        display: inline-block;
        width: 18px;
        height: 18px;
        background: #2563eb;
        color: #fff;
        border-radius: 50%;
        font-size: 0.55rem;
        line-height: 18px;
        text-align: center;
        margin-left: 4px;
        vertical-align: middle;
        font-weight: 700;
    }

    .td-empty {
        color: #e8ecf0 !important;
    }

    .cmp-legend {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 0.85rem 1.5rem;
        border-top: 1px solid #f1f3f7;
        background: #fafbfd;
        flex-wrap: wrap;
    }

    .legend-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.72rem;
        color: #94a3b8;
        font-weight: 500;
    }

    .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }
</style>

<div class="cmp-root">
    <div class="container">

        <!-- HEADER -->
        <div class="cmp-header">
            <div>
                <div class="cmp-title">Comparator <span>Mașini</span></div>
                <div class="cmp-subtitle" id="cmp-subtitle">Se încarcă...</div>
            </div>
            <div class="cmp-actions">
                <button class="btn-cmp-ghost" onclick="golesteComparator()">
                    <i class="bi bi-trash"></i> Golește tot
                </button>
                <a href="/Anunturi" class="btn-cmp-primary">
                    <i class="bi bi-plus-lg"></i> Adaugă mașină
                </a>
            </div>
        </div>

        <!-- EMPTY STATE -->
        <div id="cmp-empty" class="cmp-empty">
            <div class="cmp-empty-icon">🔍</div>
            <h4>Comparatorul tău este gol</h4>
            <p>Mergi la un anunț și apasă <strong style="color:#2563eb">"Adaugă la comparator"</strong> pentru a compara mașini.</p>
            <a href="/Anunturi" class="btn-cmp-primary" style="margin-top:4px;">
                <i class="bi bi-search"></i> Caută mașini
            </a>
        </div>

        <!-- COLUMNS: fiecare coloană = scor (sus) + card mașină (jos) -->
        <div id="cmp-columns" class="cmp-columns" style="display:none;"></div>

        <!-- TABLE -->
        <div id="compare-section" class="compare-section" style="display:none;">
            <div class="compare-section-header">
                <div class="compare-section-dot"></div>
                <div class="compare-section-title">Comparație detaliată</div>
            </div>
            <div style="overflow-x:auto;">
                <table class="compare-table">
                    <thead id="cmp-thead"></thead>
                    <tbody id="cmp-tbody"></tbody>
                </table>
            </div>
            <div class="cmp-legend">
                <div class="legend-pill">
                    <div class="legend-dot" style="background:#2563eb;"></div>
                    Albastru = cea mai avantajoasă valoare din categorie
                </div>
                <div class="legend-pill">
                    <div class="legend-dot" style="background:#e2e8f0;"></div>
                    — = slot liber
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            var lista          = JSON.parse(localStorage.getItem('comparator') || '[]');
            var columnsWrap    = document.getElementById('cmp-columns');
            var emptyDiv       = document.getElementById('cmp-empty');
            var compareSection = document.getElementById('compare-section');
            var subtitle       = document.getElementById('cmp-subtitle');

            if (lista.length === 0) {
                emptyDiv.style.display = 'flex';
                subtitle.textContent = 'Nicio mașină selectată';
                return;
            }

            subtitle.textContent = lista.length + ' din 3 mașini selectate · Albastru = cea mai avantajoasă valoare';

            /* ── helpers ── */
            function bestVal(cheie, tip) {
                var vals = lista.map(function (m) { return parseFloat(m[cheie]) || 0; });
                return tip === 'min' ? Math.min.apply(null, vals) : Math.max.apply(null, vals);
            }

            var bPret   = bestVal('pret',   'min');
            var bAn     = bestVal('an',     'max');
            var bKm     = bestVal('km',     'min');
            var bPutere = bestVal('putere', 'max');

            function isHL(m, cheie) {
                if (lista.length < 2) return false;
                var v = parseFloat(m[cheie]) || 0;
                if (cheie === 'pret')   return v === bPret;
                if (cheie === 'an')     return v === bAn;
                if (cheie === 'km')     return v === bKm;
                if (cheie === 'putere') return v === bPutere;
                return false;
            }

            /* ── scor general (0–100) ── */
            function calcScore(m) {
                var s = 0;
                if (bPret   > 0) s += (1 - (parseFloat(m.pret)   || 0) / bPret)  * 35;
                if (bAn     > 0) s += ((parseFloat(m.an)     || 0) / bAn)         * 25;
                if (bKm     > 0) s += (1 - (parseFloat(m.km)     || 0) / bKm)    * 25;
                if (bPutere > 0) s += ((parseFloat(m.putere) || 0) / bPutere)     * 15;
                return Math.round(Math.min(100, Math.max(10, s * 100 / 85)));
            }

            var scoruri = lista.map(function (m) { return calcScore(m); });
            var maxScor = Math.max.apply(null, scoruri);
            var recIdx  = scoruri.indexOf(maxScor);

            /* ── număr coloane dinamic ── */
            var totalCols = lista.length < 3 ? lista.length + 1 : 3;
            columnsWrap.style.display = 'grid';
            columnsWrap.style.gridTemplateColumns = 'repeat(' + totalCols + ', 1fr)';

            /* ── helper spec cell ── */
            function makeCell(label, val, cheie, m) {
                var hl = cheie && isHL(m, cheie) ? ' hl' : '';
                return '<div class="spec-cell' + hl + '">' +
                       '<div class="spec-cell-label">' + label + '</div>' +
                       '<div class="spec-cell-val">'   + val   + '</div>' +
                       '</div>';
            }

            /* ─────────────────────────────
               COLOANE: scor deasupra, card dedesubt
            ───────────────────────────── */
            lista.forEach(function (m, i) {
                var isRec   = (i === recIdx);
                var sc      = scoruri[i];
                var pretFmt = (parseFloat(m.pret) || 0).toLocaleString('ro-RO') + ' €';
                var kmFmt   = (parseFloat(m.km)   || 0).toLocaleString('ro-RO') + ' km';

                var imgHtml =
                    '<img src="/Anunturi/GetImagine/' + m.id + '" alt="' + m.nume + '" ' +
                    'onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'">' +
                    '<div class="car-img-placeholder" style="display:none;">🚗</div>';

                var s1 = makeCell('Preț',        pretFmt,                             'pret',   m) +
                         makeCell('An',           m.an || '-',                         'an',     m) +
                         makeCell('Kilometraj',   kmFmt,                               'km',     m);

                var s2 = makeCell('Combustibil',  m.combustibil || '-',               '',       m) +
                         makeCell('Putere',       m.putere ? m.putere + ' CP' : '-',  'putere', m) +
                         makeCell('Transmisie',   m.transmisie || '-',                '',       m);

                /* coloana */
                var col = document.createElement('div');
                col.className = 'cmp-col';
                col.style.animationDelay = (i * 0.07) + 's';

                /* ── scor card (sus) ── */
                var scoreDiv = document.createElement('div');
                scoreDiv.className = 'score-card' + (isRec ? ' best-score' : '');
                scoreDiv.innerHTML =
                    '<div class="score-label">Scor general</div>' +
                    '<div class="score-name">' +
                        (isRec ? '<i class="bi bi-patch-check-fill me-1" style="color:#2563eb;font-size:.85rem;"></i>' : '') +
                        m.nume +
                    '</div>' +
                    '<div class="score-bar-wrap">' +
                        '<div class="score-bar-fill" style="width:0%" data-w="' + sc + '"></div>' +
                    '</div>' +
                    '<div class="score-pct"><span>' + sc + '</span> / 100</div>';

                /* ── car card (jos) ── */
                var carDiv = document.createElement('div');
                carDiv.className = 'car-card' + (isRec ? ' best-value' : '');
                carDiv.innerHTML =
                    (isRec ? '<div class="best-badge"><i class="bi bi-patch-check-fill me-1"></i>Recomandat</div>' : '') +

                    '<div class="car-img-wrap">' + imgHtml +
                        '<div class="car-price-tag' + (isHL(m, 'pret') ? ' best-price' : '') + '">' + pretFmt + '</div>' +
                    '</div>' +

                    '<div class="car-body">' +
                        '<div class="car-name">' + m.nume + '</div>' +
                        '<div class="car-location">' +
                            '<i class="bi bi-geo-alt-fill" style="color:#ef4444;font-size:.72rem;"></i>' +
                            '&nbsp;' + (m.locatie || 'Locație necunoscută') +
                        '</div>' +
                    '</div>' +

                    '<div class="specs-strip">'   + s1 + '</div>' +
                    '<div class="specs-strip-2">' + s2 + '</div>' +

                    '<div class="car-footer">' +
                        '<a href="/Anunturi/Details/' + m.id + '" class="btn-car-view">' +
                            '<i class="bi bi-eye"></i> Vezi anunț' +
                        '</a>' +
                        '<button class="btn-car-remove" onclick="stergeComparator(' + m.id + ')" title="Elimină">' +
                            '<i class="bi bi-x-lg"></i>' +
                        '</button>' +
                    '</div>';

                col.appendChild(scoreDiv);
                col.appendChild(carDiv);
                columnsWrap.appendChild(col);
            });

            /* ── slot + (coloană goală) ── */
            if (lista.length < 3) {
                var addCol = document.createElement('div');
                addCol.className = 'cmp-col';
                addCol.style.animationDelay = (lista.length * 0.07) + 's';

                var scorePlaceholder = document.createElement('div');
                scorePlaceholder.className = 'score-card';
                scorePlaceholder.style.cssText = 'border-style:dashed;background:transparent;opacity:0.45;';
                scorePlaceholder.innerHTML =
                    '<div class="score-label">Scor general</div>' +
                    '<div class="score-name" style="color:#cbd5e1;">— Slot liber —</div>' +
                    '<div class="score-bar-wrap"></div>' +
                    '<div class="score-pct" style="color:#e2e8f0;">— / 100</div>';

                var addCard = document.createElement('a');
                addCard.href = '/Anunturi';
                addCard.className = 'add-card';
                addCard.innerHTML =
                    '<div class="add-icon"><i class="bi bi-plus-lg"></i></div>' +
                    '<div class="add-text">Adaugă a ' + (lista.length + 1) + '-a mașină</div>' +
                    '<div class="add-hint">maxim 3 mașini</div>';

                addCol.appendChild(scorePlaceholder);
                addCol.appendChild(addCard);
                columnsWrap.appendChild(addCol);
            }

            /* ── animație bare ── */
            setTimeout(function () {
                document.querySelectorAll('.score-bar-fill').forEach(function (el) {
                    el.style.width = el.getAttribute('data-w') + '%';
                });
            }, 100);

            /* ─────────────────────────────
               TABEL
            ───────────────────────────── */
            compareSection.style.display = 'block';

            var rows = [
                { c:'pret',        l:'💰 Preț',         f:function(v){ return (parseFloat(v)||0).toLocaleString('ro-RO')+' €'; },  t:'min' },
                { c:'an',          l:'📅 An fabricație', f:function(v){ return v||'-'; },                                            t:'max' },
                { c:'km',          l:'📍 Kilometraj',    f:function(v){ return (parseFloat(v)||0).toLocaleString('ro-RO')+' km'; }, t:'min' },
                { c:'putere',      l:'⚡ Putere',        f:function(v){ return v ? v+' CP' : '-'; },                                 t:'max' },
                { c:'motor',       l:'🔧 Motor',         f:function(v){ return v ? v+' cm³' : '-'; },                                t:null  },
                { c:'combustibil', l:'⛽ Combustibil',   f:function(v){ return v||'-'; },                                            t:null  },
                { c:'transmisie',  l:'⚙️ Transmisie',    f:function(v){ return v||'-'; },                                            t:null  },
                { c:'caroserie',   l:'🚗 Caroserie',     f:function(v){ return v||'-'; },                                            t:null  }
            ];

            var th = '<tr><th style="width:160px">Specificație</th>';
            lista.forEach(function (m) { th += '<th>' + m.nume + '</th>'; });
            if (lista.length < 3) th += '<th style="color:#e2e8f0">— Slot liber —</th>';
            th += '</tr>';
            document.getElementById('cmp-thead').innerHTML = th;

            var tb = '';
            rows.forEach(function (row) {
                var bv = row.t ? bestVal(row.c, row.t) : null;
                tb += '<tr><td>' + row.l + '</td>';
                lista.forEach(function (m) {
                    var raw  = parseFloat(m[row.c]) || 0;
                    var best = bv !== null && raw === bv && lista.length > 1;
                    tb += '<td class="' + (best ? 'td-best' : '') + '">' +
                          row.f(m[row.c]) +
                          (best ? '<span class="td-best-icon">✓</span>' : '') +
                          '</td>';
                });
                if (lista.length < 3) tb += '<td class="td-empty">—</td>';
                tb += '</tr>';
            });

            tb += '<tr><td>🔗 Link anunț</td>';
            lista.forEach(function (m) {
                tb += '<td><a href="/Anunturi/Details/' + m.id + '" class="btn-car-view" style="max-width:150px;margin:0 auto;">' +
                      '<i class="bi bi-eye"></i> Vezi</a></td>';
            });
            if (lista.length < 3) tb += '<td class="td-empty">—</td>';
            tb += '</tr>';

            document.getElementById('cmp-tbody').innerHTML = tb;
        });

        /* ── globale ── */
        function stergeComparator(id) {
            var lista = JSON.parse(localStorage.getItem('comparator') || '[]');
            lista = lista.filter(function (x) { return x.id !== id; });
            localStorage.setItem('comparator', JSON.stringify(lista));
            location.reload();
        }

        function golesteComparator() {
            if (confirm('Ești sigur că vrei să golești comparatorul?')) {
                localStorage.removeItem('comparator');
                location.reload();
            }
        }
    </script>
}
