@model Platforma_pentru_tranzactii_auto.Models.DreamCarComparisonViewModel

@{
    ViewData["Title"] = "Studiu Comparativ Recomandări";
    // Extragere date pentru graficul de comparație (primele mașini din fiecare top)
    var topStil = Model.RecomandariStil.FirstOrDefault();
    var topPrecizie = Model.RecomandariPrecizie.FirstOrDefault();
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Analiză Comparativă Dream Car 🤖</h2>
            <p class="text-muted">Am utilizat doi algoritmi diferiți pentru a-ți oferi perspective variate asupra pieței.</p>
        </div>
        <a asp-action="DreamCar" class="btn btn-outline-secondary">← Nouă Căutare</a>
    </div>

    @if (!(Model.RecomandariStil?.Any() ?? false) && !(Model.RecomandariPrecizie?.Any() ?? false))
    {
        <div class="alert alert-warning text-center">
            Nu am găsit mașini potrivite. Încearcă să relaxezi filtrele de căutare.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-5" style="border-radius: 20px; background: #fdfdfd;">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-5">
                        <h4 class="fw-bold"><i class="bi bi-intersect"></i> Stil vs. Precizie</h4>
                        <p class="small text-muted">
                            Graficul suprapune <strong>cea mai bună alegere de Stil</strong> (Cosine) peste
                            <strong>cea mai bună alegere de Puncte</strong> (KNN).
                            Zonele mai mari indică o performanță mai bună pe acel criteriu.
                        </p>
                        <ul class="list-unstyled small">
                            <li><i class="bi bi-circle-fill text-primary"></i> <strong>Cosine Similarity:</strong> Optimizează raportul dintre atribute.</li>
                            <li><i class="bi bi-circle-fill text-info"></i> <strong>KNN Euclidean:</strong> Caută valorile cele mai apropiate de cerința ta.</li>
                        </ul>
                    </div>
                    <div class="col-md-7">
                        <canvas id="comparisonRadar" style="max-height: 350px;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-5">
            <h3 class="fw-bold mb-3"><i class="bi bi-compass text-primary"></i> Top Recomandări: Profil & Stil</h3>
            <p class="text-muted mb-4 small">Aceste mașini respectă echilibrul caracteristicilor cerute (ex: raport Putere/Preț).</p>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var result in Model.RecomandariStil)
                {
                    <div class="col">
                        @await Html.PartialAsync("_CarCardPartial", result)
                    </div>
                }
            </div>
        </div>

        <hr class="my-5 opacity-25" />

        <div class="mb-5">
            <h3 class="fw-bold mb-3"><i class="bi bi-ruler text-info"></i> Top Recomandări: Precizie Matematică</h3>
            <p class="text-muted mb-4 small">Aceste mașini au valorile cele mai apropiate de cifrele exacte introduse de tine.</p>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var result in Model.RecomandariPrecizie)
                {
                    <div class="col">
                        @await Html.PartialAsync("_CarCardPartial", result)
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @if (topStil != null && topPrecizie != null)
        {
            <text>
                    const ctxRadar = document.getElementById('comparisonRadar').getContext('2d');

                    // Funcție de normalizare pentru grafic
                    function normValue(val, min, max) {
                        return Math.round(((val - min) / (max - min)) * 100);
                    }

                    const dataStil = [
                        100 - normValue(@topStil.Anunt.Pret, @topStil.GlobalMinPret, @topStil.GlobalMaxPret),
                        normValue(@topStil.Anunt.An_Fabricatie, @topStil.GlobalMinAn, @topStil.GlobalMaxAn),
                        100 - normValue(@topStil.Anunt.Kilometraj, @topStil.GlobalMinKm, @topStil.GlobalMaxKm),
                        normValue(@topStil.Anunt.PutereCP, @topStil.GlobalMinPutere, @topStil.GlobalMaxPutere),
                        normValue(@topStil.Anunt.CapacitateMotor, @topStil.GlobalMinCapacitate, @topStil.GlobalMaxCapacitate)
                    ];

                    const dataPrecizie = [
                        100 - normValue(@topPrecizie.Anunt.Pret, @topPrecizie.GlobalMinPret, @topPrecizie.GlobalMaxPret),
                        normValue(@topPrecizie.Anunt.An_Fabricatie, @topPrecizie.GlobalMinAn, @topPrecizie.GlobalMaxAn),
                        100 - normValue(@topPrecizie.Anunt.Kilometraj, @topPrecizie.GlobalMinKm, @topPrecizie.GlobalMaxKm),
                        normValue(@topPrecizie.Anunt.PutereCP, @topPrecizie.GlobalMinPutere, @topPrecizie.GlobalMaxPutere),
                        normValue(@topPrecizie.Anunt.CapacitateMotor, @topPrecizie.GlobalMinCapacitate, @topPrecizie.GlobalMaxCapacitate)
                    ];

                    new Chart(ctxRadar, {
                        type: 'radar',
                        data: {
                            labels: ['Preț Avantajos', 'An Fabricație', 'Kilometraj Redus', 'Putere CP', 'Capacitate'],
                            datasets: [
                                {
                                    label: 'Top Stil (@topStil.Anunt.Marca)',
                                    data: dataStil,
                                    borderColor: '#0d6efd',
                                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                                    borderWidth: 3,
                                    pointRadius: 4
                                },
                                {
                                    label: 'Top Precizie (@topPrecizie.Anunt.Marca)',
                                    data: dataPrecizie,
                                    borderColor: '#0dcaf0',
                                    backgroundColor: 'rgba(13, 202, 240, 0.1)',
                                    borderWidth: 3,
                                    pointRadius: 4
                                }
                            ]
                        },
                        options: {
                            scales: {
                                r: {
                                    min: 0, max: 100,
                                    ticks: { display: false },
                                    grid: { color: 'rgba(0,0,0,0.05)' }
                                }
                            },
                            plugins: {
                                legend: { position: 'bottom' }
                            }
                        }
                    });
            </text>
        }
    </script>
}